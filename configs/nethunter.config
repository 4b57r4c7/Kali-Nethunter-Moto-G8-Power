# NetHunter функции върху стоковото ядро (ползва се с extra_fragment=nethunter.config).
#
# Правило: пипаме само опции, които НЕ променят структури, ползвани от vendor модулите
# (Wi-Fi qca_cld3, тъч и др.). Иначе modversions CRC се разминава и модулът не се зарежда.
#   - CONFIG_CFG80211_WEXT НЕ се включва: добавя полета в struct wireless_dev
#     (include/net/cfg80211.h) и чупи вградения Wi-Fi. Инструментите ползват nl80211.
#   - CONFIG_BT_LEDS НЕ се включва: променя struct hci_dev.
# Всичко е вградено (=y), защото при `fastboot boot` няма къде да се сложат .ko файлове.

# --- HID (клавиатура/мишка през USB) ---
# Стоковото ядро вече има HID gadget функцията (/dev/hidg*); фиксираме я изрично.
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_F_HID=y
CONFIG_USB_F_HID=y

# --- mac80211 стек (нужен за външните USB Wi-Fi адаптери) ---
CONFIG_MAC80211=y
CONFIG_MAC80211_RC_MINSTREL=y
CONFIG_MAC80211_RC_MINSTREL_HT=y
CONFIG_MAC80211_RC_DEFAULT_MINSTREL=y
# CONFIG_MAC80211_MESH is not set
# CONFIG_MAC80211_DEBUGFS is not set

# --- USB Wi-Fi адаптери с monitor mode и injection ---
# Atheros AR9271 / AR7010 (Alfa AWUS036NHA, TP-Link TL-WN722N v1)
CONFIG_ATH9K_HTC=y
# Atheros AR9170
CONFIG_CARL9170=y
# Ralink/MediaTek RT2870/RT3070/RT3572/RT5370/RT5572 (Alfa AWUS036NH, AWUS051NH)
CONFIG_RT2X00=y
CONFIG_RT2800USB=y
CONFIG_RT2800USB_RT33XX=y
CONFIG_RT2800USB_RT35XX=y
CONFIG_RT2800USB_RT3573=y
CONFIG_RT2800USB_RT53XX=y
CONFIG_RT2800USB_RT55XX=y
CONFIG_RT2800USB_UNKNOWN=y
CONFIG_RT73USB=y
# MediaTek MT7601U
CONFIG_MT7601U=y
# Realtek RTL8187 (Alfa AWUS036H)
CONFIG_RTL8187=y
# Realtek RTL8188CU/RTL8192CU/RTL8192EU/RTL8723BU
CONFIG_RTL8XXXU=y
CONFIG_RTL8XXXU_UNTESTED=y

# --- Bluetooth (външни USB донгъли, BlueZ инструменти) ---
CONFIG_BT_RFCOMM=y
CONFIG_BT_RFCOMM_TTY=y
CONFIG_BT_BNEP=y
CONFIG_BT_BNEP_MC_FILTER=y
CONFIG_BT_BNEP_PROTO_FILTER=y
CONFIG_BT_HIDP=y
CONFIG_BT_HCIBTUSB=y
CONFIG_BT_HCIBTUSB_BCM=y
CONFIG_BT_HCIBTUSB_RTL=y
# CONFIG_BT_LEDS is not set
